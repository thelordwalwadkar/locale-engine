# Copy to `.env` and fill in only the providers you use. `.env` is git-ignored. Never commit keys.
# Variable NAMES here must match `api_key_env` / `base_url_env` in config/providers.yaml (tests/providers.config.test.ts checks it).
# A routed provider without a key falls back to routing.default_provider (logged PROVIDER_FALLBACK).

# --- Provider credentials -------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Google Gemini API key (AI Studio)
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=

# --- Local models (Ollama) --------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434

# --- Run defaults (all optional; CLI flags override) ------------------------------
LOCALE_OUTPUT_DIR=./output
LOCALE_COST_CEILING_USD=5.00
LOCALE_LOG_LEVEL=info

# --- Polite fetching --------------------------------------------------------------
# Sent in the User-Agent header so site owners can reach you. Recommended.
LOCALE_CONTACT=

# --- Web app (locale-web) ---------------------------------------------------------
# First start creates this administrator (without a password a random one is printed once).
LOCALE_ADMIN_USER=admin
LOCALE_ADMIN_PASSWORD=
# LOCALE_WEB_HOST=127.0.0.1      # 0.0.0.0 to serve beyond this computer (set automatically when PORT is set)
# LOCALE_WEB_PORT=8080           # or PORT
# LOCALE_DATA_DIR=./data         # the database and every job's files; keep it on a persistent disk
# LOCALE_WEB_JOB_CEILING_USD=2   # most one job may spend
# LOCALE_WEB_DAILY_LIMIT_USD=10  # default daily limit per new user
# LOCALE_WEB_CONCURRENCY=1       # jobs at once
# LOCALE_WEB_SECURE=1            # set when served over HTTPS (cookie gets the Secure flag)
# LOCALE_WEB_TRUST_PROXY=1       # behind a reverse proxy that sets X-Forwarded-For
# LOCALE_WEB_DEMO=1              # no keys needed: every stage on the offline test model (placeholder text)
